# Django Secret Key (generate a secure key for production)
SECRET_KEY=django-insecure-change-this-in-production-key-12345

# Debug Mode (True for local development, False for production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Leave blank to use local db.sqlite3, or provide PostgreSQL URL)
# DATABASE_URL=postgres://user:password@localhost:5432/nirvana_db

# CORS Allowed Origins for Next.js frontend (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cloudflare R2 / S3 Storage (Set to True for cloud media, False for local)
USE_R2_STORAGE=False
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=nirvanaspace-media
CLOUDFLARE_R2_ENDPOINT_URL=
CLOUDFLARE_R2_CUSTOM_DOMAIN=

# JWT Token Expiry
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
